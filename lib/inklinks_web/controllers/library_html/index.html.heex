<Layouts.app>
  <h1>Library</h1>

  <p :if={@inklinks == []}>No Inklinks yet.</p>

  <ul :if={@inklinks != []} aria-label="Inklinks">
    <li :for={%{entry: inklink} = item <- @inklinks}>
      <article aria-labelledby={"inklink-#{inklink.id}"}>
        <h2 id={"inklink-#{inklink.id}"}>{inklink.title}</h2>
        <dl>
          <div>
            <dt>Kind</dt>
            <dd>{describe(inklink.kind)}</dd>
          </div>
          <div>
            <dt>Mode</dt>
            <dd>{describe(inklink.mode)}</dd>
          </div>
          <div :if={inklink.inquests > 0}>
            <dt>Inquests</dt>
            <dd>{inklink.inquests}</dd>
          </div>
        </dl>

        <%= case item.playable do %>
          <% :ok -> %>
            <form method="post" action={~p"/inklinks/#{inklink.id}/readings"}>
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button>{if item.current, do: "Continue", else: "Read"}</button>
            </form>
            <a :if={item.finished} href={~p"/readings/#{item.finished}/path"}>Your last path</a>
          <% {:unsupported, reasons} -> %>
            <details>
              <summary>Not playable yet</summary>
              <p>This engine cannot play {Enum.join(reasons, ", ")}.</p>
            </details>
        <% end %>
      </article>
    </li>
  </ul>
</Layouts.app>
